Pipeline{
    Agent Any
    Stages{
        Stage('Checkout')
        {

            Checkout scm
            Echo 'Successfully checkout from scm'
        }
        Stage('Install Dependencies')
        {
            Bat 'npm install'
            Echo 'Successfully installed'
        }
        Stage('Run build')
        {
            Bat 'npm run build'
            Echo 'Successfully run'
        }
    }
    Post{
        Success{
            Echo 'Successfully deployed'
        }
        Failure
        {
            Echo 'Failure'
        }
    }
}
